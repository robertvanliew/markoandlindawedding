NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=          # at least 8 characters, shared by the couple
BREVO_API_KEY=           # Brevo API key: sends the invitations (no domain needed)
EMAIL_SENDER=            # the sender address verified in Brevo, e.g. the couple's Gmail
GMAIL_USER=              # the couple's Gmail, sends the invitations
GMAIL_APP_PASSWORD=      # Google app password for that Gmail (16 letters)
RESEND_API_KEY=          # optional alternative to Gmail (needs a verified domain to email guests)
NOTIFY_EMAIL=            # optional, couple's inbox
EMAIL_FROM=              # optional, defaults to "Linda & Marko" <GMAIL_USER>
